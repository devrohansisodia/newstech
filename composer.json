{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "files": [
            "packages/NewsTech/Core/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "NewsTech\\Admin\\": "packages/NewsTech/Admin/",
            "NewsTech\\Advertisement\\": "packages/NewsTech/Advertisement/",
            "NewsTech\\Author\\": "packages/NewsTech/Author/",
            "NewsTech\\Article\\": "packages/NewsTech/Article/",
            "NewsTech\\Category\\": "packages/NewsTech/Category/",
            "NewsTech\\Comment\\": "packages/NewsTech/Comment/",
            "NewsTech\\Core\\": "packages/NewsTech/Core/",
            "NewsTech\\Frontend\\": "packages/NewsTech/Frontend/",
            "NewsTech\\Installer\\": "packages/NewsTech/Installer/",
            "NewsTech\\Bookmark\\": "packages/NewsTech/Bookmark/",
            "NewsTech\\Menu\\": "packages/NewsTech/Menu/",
            "NewsTech\\Media\\": "packages/NewsTech/Media/",
            "NewsTech\\Newsletter\\": "packages/NewsTech/Newsletter/",
            "NewsTech\\Page\\": "packages/NewsTech/Page/",
            "NewsTech\\Reader\\": "packages/NewsTech/Reader/",
            "NewsTech\\Seo\\": "packages/NewsTech/Seo/",
            "NewsTech\\Tag\\": "packages/NewsTech/Tag/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"echo 'NewsTech is installed. Configure .env and run php artisan newstech:install'.PHP_EOL;\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
